                            <Label fx:id="equipErrCategory" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                        <VBox spacing="3" prefWidth="90">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Qty *" />
