                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="membersSearchField" onKeyReleased="#handleMembersSearch" prefHeight="34" prefWidth="260" promptText="Search name, status, membership, age, sex..." style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-prompt-text-fill: #555;                                       -fx-border-color: #333; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 12;" />
                    <Button onAction="#handleRefreshMembersTab" prefHeight="34" style="-fx-background-color: #1a1a1a; -fx-text-fill: #aaa; -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;" text="⟳ Refresh" />
                </HBox>

                <!-- Edit form panel — shown when a row is selected -->
                <VBox fx:id="memberEditPanel" managed="false" spacing="10" style="-fx-padding: 14 16 14 16; -fx-background-color: #111; -fx-border-color: #222; -fx-border-width: 0 0 1 0;" visible="false">

                    <HBox alignment="CENTER_LEFT" spacing="8">
