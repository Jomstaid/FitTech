                <!-- Members table — read-only summary, click a row to edit -->
                <TableView fx:id="membersTable" onMouseClicked="#handleMembersTableClick" style="-fx-background-color: #1a1a1a; -fx-border-color: #333;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="mColId" maxWidth="56" minWidth="40" prefWidth="50" text="ID" />
                        <TableColumn fx:id="mColName" prefWidth="200" text="Full Name" />
                        <TableColumn fx:id="mColUsername" prefWidth="130" text="Username" />
                        <TableColumn fx:id="mColEmail" prefWidth="200" text="Email" />
                        <TableColumn fx:id="mColPhone" prefWidth="130" text="Phone" />
                        <TableColumn fx:id="mColGender" prefWidth="80" text="Sex" />
                        <TableColumn fx:id="mColBirthdate" prefWidth="110" text="Birthdate" />
                        <TableColumn fx:id="mColAge" prefWidth="55" text="Age" />
                        <TableColumn fx:id="mColMembership" prefWidth="100" text="Membership" />
                        <TableColumn fx:id="mColStatus" prefWidth="90" text="Status" />
                        <TableColumn fx:id="mColExpiry" prefWidth="110" text="Expiry" />
                        <TableColumn fx:id="mColDaysLeft" prefWidth="90" text="Days Left" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555; -fx-font-size: 13;" text="No members loaded." />
                    </placeholder>
                </TableView>

                <!-- Footer -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 8 16 8 16; -fx-background-color: #0d0d0d;">
                    <Label style="-fx-text-fill: #444; -fx-font-size: 10;" text="Click any row to edit. All changes are validated before saving." />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="membersTabStatus" style="-fx-text-fill: #555; -fx-font-size: 11;" text="" />
                </HBox>

            </VBox>
        </Tab>

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 7 — RENEWAL REQUESTS                -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="🔄  Renewal Requests">
            <VBox spacing="10" style="-fx-padding: 16; -fx-background-color: #0f0f0f;">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #00e5ff;"
                           text="Member Renewal Requests" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #555;"
                           text="(Approve · Reject · Refund)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="renewalSummaryLabel"
                           style="-fx-text-fill: #ff8c00; -fx-font-size: 12; -fx-font-weight: bold;
                                  -fx-background-color: rgba(255,140,0,0.08); -fx-padding: 4 10;
                                  -fx-background-radius: 12;" text="" />
                    <Button onAction="#handleRefreshRenewal" prefHeight="34"
                            style="-fx-background-color: #333; -fx-text-fill: white;
                                   -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 12;" text="⟳ Refresh" />
                </HBox>

                <!-- Filter buttons: Pending / All -->
                <HBox spacing="8">
                    <Button fx:id="renewFilterExpired" onAction="#handleRenewalFilterExpired" prefHeight="30"
                            style="-fx-background-color: #1a1a00; -fx-text-fill: #ffd700; -fx-font-weight: bold;
                                   -fx-border-color: #3a3a00; -fx-border-radius: 4;
                                   -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 11;" text="⏳ Pending" />
                    <Button fx:id="renewFilterAll" onAction="#handleRenewalFilterAll" prefHeight="30"
                            style="-fx-background-color: #1a1a1a; -fx-text-fill: #aaa;
                                   -fx-border-color: #333; -fx-border-radius: 4;
                                   -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 11;" text="All Requests" />
                </HBox>

                <TableView fx:id="renewalTable" style="-fx-background-color: #1a1a1a; -fx-border-color: #333;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="renColId"         prefWidth="55"  text="Req #" />
                        <TableColumn fx:id="renColName"       prefWidth="180" text="Member" />
                        <TableColumn fx:id="renColUsername"   prefWidth="120" text="Username" />
                        <TableColumn fx:id="renColMembership" prefWidth="160" text="Current → Requested" />
                        <TableColumn fx:id="renColStatus"     prefWidth="90"  text="Status" />
                        <TableColumn fx:id="renColExpiry"     prefWidth="110" text="Live Expiry" />
                        <TableColumn fx:id="renColDaysLeft"   prefWidth="110" text="Days Left" />
                        <TableColumn fx:id="renColPhone"      prefWidth="100" text="Amount (₱)" />
                        <TableColumn fx:id="renColEmail"      prefWidth="140" text="Submitted On" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555; -fx-font-size: 13;"
                               text="No renewal requests. Click Refresh." />
                    </placeholder>
                </TableView>

                <!-- Action row — Approve, Reject, Refund -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 0 0 0;">
                    <Button onAction="#handleRenewMember" prefHeight="38" prefWidth="160"
                            style="-fx-background-color: #1a3a1a; -fx-text-fill: #7cff6b; -fx-font-weight: bold;
                                   -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;
                                   -fx-border-color: #2a5a2a; -fx-border-radius: 4;" text="✓  Approve" />
                    <Button onAction="#handleRejectRenewal" prefHeight="38" prefWidth="160"
                            style="-fx-background-color: #3a1a1a; -fx-text-fill: #ff5555; -fx-font-weight: bold;
                                   -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;
                                   -fx-border-color: #5a2a2a; -fx-border-radius: 4;" text="✗  Reject" />
                    <Button onAction="#handleRefundRenewal" prefHeight="38" prefWidth="160"
                            style="-fx-background-color: #1a103a; -fx-text-fill: #b57bff; -fx-font-weight: bold;
                                   -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;
                                   -fx-border-color: #2a1a5a; -fx-border-radius: 4;" text="↩  Refund" />
                    <!-- renewMembershipCombo kept for backwards compatibility with setupRenewalTab -->
                    <ComboBox fx:id="renewMembershipCombo" managed="false" visible="false" prefHeight="34"
