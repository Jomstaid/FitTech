        <!--  TAB 9 — PASSWORD RESET                  -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="🔑  Reset Password">
            <VBox spacing="0" style="-fx-background-color: #0f0f0f;">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 14 16 10 16; -fx-background-color: #0f0f0f;">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="Member Password Reset" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #555;"
                           text="Face-to-face reset — generate token, read it to member, set new password in one sitting." />
                </HBox>

                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: #0f0f0f; -fx-background: #0f0f0f;" VBox.vgrow="ALWAYS">
                    <VBox spacing="14" style="-fx-padding: 10 60 24 60; -fx-background-color: #0f0f0f; -fx-max-width: 680;">

                        <!-- STEP 1 — Find member by Gmail -->
                        <VBox spacing="10"
                              style="-fx-background-color: #111; -fx-border-color: #222; -fx-border-radius: 6;
                                     -fx-background-radius: 6; -fx-padding: 16;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #00e5ff;
                                              -fx-background-color: #00e5ff22; -fx-padding: 2 8;
                                              -fx-background-radius: 10;" text="STEP 1" />
                                <Label style="-fx-font-size: 12; -fx-text-fill: #ccc;" text="Enter the member's Gmail address" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <TextField fx:id="pwrEmailField" prefHeight="38" prefWidth="340"
                                           promptText="member@gmail.com"
                                           style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                                                  -fx-prompt-text-fill: #555; -fx-border-color: #333;
                                                  -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 13;" />
                                <Button fx:id="pwrGenerateBtn" onAction="#handleGenerateToken" prefHeight="38" prefWidth="180"
                                        style="-fx-background-color: #00e5ff; -fx-text-fill: #0f0f0f; -fx-font-weight: bold;
                                               -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;"
                                        text="🔑 Generate Token" />
                            </HBox>
                            <Label fx:id="pwrStep1Status" style="-fx-font-size: 12; -fx-text-fill: #aaa;" text="" />
                        </VBox>

                        <!-- STEP 2 — Token display (shows after step 1 succeeds) -->
                        <VBox fx:id="pwrStep2Box" managed="false" spacing="10" visible="false"
                              style="-fx-background-color: #111; -fx-border-color: #222; -fx-border-radius: 6;
                                     -fx-background-radius: 6; -fx-padding: 16;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #ffd700;
                                              -fx-background-color: #ffd70022; -fx-padding: 2 8;
                                              -fx-background-radius: 10;" text="STEP 2" />
                                <Label style="-fx-font-size: 12; -fx-text-fill: #ccc;" text="Read this token to the member" />
                            </HBox>
                            <HBox alignment="CENTER" spacing="0"
                                  style="-fx-background-color: #0a1a0a; -fx-border-color: #7cff6b;
                                         -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 14 24;">
                                <Label fx:id="pwrTokenDisplay"
                                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #7cff6b;
                                              -fx-font-family: 'Courier New', monospace; -fx-letter-spacing: 8px;" text="— — — — — —" />
                            </HBox>
                            <Label style="-fx-font-size: 11; -fx-text-fill: #666;"
                                   text="⚠ Token expires in 10 minutes. Read it clearly to the member standing in front of you." />
                            <HBox>
                                <Label fx:id="pwrMemberName" style="-fx-font-size: 11; -fx-text-fill: #aaa;" text="" />
                            </HBox>
                        </VBox>

                        <!-- STEP 3 — New password (shows after step 2) -->
                        <VBox fx:id="pwrStep3Box" managed="false" spacing="10" visible="false"
                              style="-fx-background-color: #111; -fx-border-color: #222; -fx-border-radius: 6;
                                     -fx-background-radius: 6; -fx-padding: 16;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #b57bff;
                                              -fx-background-color: #b57bff22; -fx-padding: 2 8;
                                              -fx-background-radius: 10;" text="STEP 3" />
                                <Label style="-fx-font-size: 12; -fx-text-fill: #ccc;"
                                       text="Member tells you their new password — type it here" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="New Password" />
                                    <PasswordField fx:id="pwrNewPassword" prefHeight="38"
                                                   style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                                                          -fx-border-color: #333; -fx-border-radius: 4;
                                                          -fx-background-radius: 4; -fx-font-size: 13;" />
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Confirm Password" />
                                    <PasswordField fx:id="pwrConfirmPassword" prefHeight="38"
                                                   style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                                                          -fx-border-color: #333; -fx-border-radius: 4;
                                                          -fx-background-radius: 4; -fx-font-size: 13;" />
                                </VBox>
                            </HBox>
                            <Label fx:id="pwrPasswordErr" style="-fx-text-fill: #ff5555; -fx-font-size: 11;" text="" />
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Button fx:id="pwrResetBtn" onAction="#handleConfirmReset" prefHeight="40" prefWidth="200"
                                        style="-fx-background-color: #b57bff; -fx-text-fill: #0f0f0f; -fx-font-weight: bold;
                                               -fx-font-size: 13; -fx-background-radius: 4; -fx-cursor: hand;"
                                        text="✓ Confirm Password Reset" />
                                <Button onAction="#handleCancelReset" prefHeight="40"
                                        style="-fx-background-color: #222; -fx-text-fill: #aaa; -fx-font-size: 12;
                                               -fx-background-radius: 4; -fx-cursor: hand;" text="✕ Start Over" />
                            </HBox>
                            <Label fx:id="pwrResetStatus" style="-fx-font-size: 12; -fx-text-fill: #aaa;" text="" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>
        </Tab>

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 9 — ANALYTICS                       -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="📊  Analytics">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #0f0f0f; -fx-background: #0f0f0f;">
                <VBox spacing="16" style="-fx-padding: 16; -fx-background-color: #0f0f0f;">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="Gym Analytics Overview" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleRefreshAnalytics" prefHeight="34"
                                style="-fx-background-color: #333; -fx-text-fill: white;
                                       -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 12;" text="⟳ Refresh" />
                    </HBox>

                    <!-- KPI Cards row -->
                    <HBox spacing="12">
                        <VBox alignment="CENTER" prefHeight="90" prefWidth="180"
                              style="-fx-background-color: #111; -fx-border-color: #00e5ff;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 12; -fx-background-radius: 4;">
                            <Label fx:id="anTotalMembers" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="—" />
                            <Label style="-fx-font-size: 10; -fx-text-fill: #555;" text="TOTAL MEMBERS" />
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="90" prefWidth="180"
                              style="-fx-background-color: #111; -fx-border-color: #7cff6b;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 12; -fx-background-radius: 4;">
                            <Label fx:id="anActiveMembers" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #7cff6b;" text="—" />
                            <Label style="-fx-font-size: 10; -fx-text-fill: #555;" text="ACTIVE MEMBERS" />
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="90" prefWidth="180"
                              style="-fx-background-color: #111; -fx-border-color: #ff5555;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 12; -fx-background-radius: 4;">
                            <Label fx:id="anExpiredMembers" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ff5555;" text="—" />
                            <Label style="-fx-font-size: 10; -fx-text-fill: #555;" text="EXPIRED" />
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="90" prefWidth="180"
                              style="-fx-background-color: #111; -fx-border-color: #ffd700;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 12; -fx-background-radius: 4;">
                            <Label fx:id="anExpiringSoon" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ffd700;" text="—" />
                            <Label style="-fx-font-size: 10; -fx-text-fill: #555;" text="EXPIRING ≤ 7 DAYS" />
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="90" prefWidth="180"
                              style="-fx-background-color: #111; -fx-border-color: #ff8c00;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 12; -fx-background-radius: 4;">
                            <Label fx:id="anTodayCheckins" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ff8c00;" text="—" />
                            <Label style="-fx-font-size: 10; -fx-text-fill: #555;" text="CHECK-INS TODAY" />
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="90" prefWidth="180"
                              style="-fx-background-color: #111; -fx-border-color: #b57bff;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 12; -fx-background-radius: 4;">
                            <Label fx:id="anRevenue" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #b57bff;" text="—" />
                            <Label style="-fx-font-size: 10; -fx-text-fill: #555;" text="TOTAL REVENUE (₱)" />
                        </VBox>
                    </HBox>

                    <!-- Membership breakdown table -->
                    <VBox spacing="6" style="-fx-background-color: #111; -fx-border-color: #222; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 14;">
                        <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="MEMBERSHIP BREAKDOWN" />
                        <TableView fx:id="anBreakdownTable" prefHeight="160"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #333;">
                            <columns>
                                <TableColumn fx:id="anBrkType"    prefWidth="140" text="Membership" />
                                <TableColumn fx:id="anBrkCount"   prefWidth="100" text="Members" />
                                <TableColumn fx:id="anBrkActive"  prefWidth="100" text="Active" />
                                <TableColumn fx:id="anBrkExpired" prefWidth="100" text="Expired" />
                                <TableColumn fx:id="anBrkRevenue" prefWidth="150" text="Revenue (₱)" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-text-fill: #555;" text="No data." />
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- Recent check-ins table -->
                    <VBox spacing="6" style="-fx-background-color: #111; -fx-border-color: #222; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 14;">
                        <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="RECENT CHECK-INS (Last 20)" />
                        <TableView fx:id="anCheckinsTable" prefHeight="240"
                                   style="-fx-background-color: #1a1a1a; -fx-border-color: #333;">
                            <columns>
                                <TableColumn fx:id="anChkName"       prefWidth="200" text="Member" />
                                <TableColumn fx:id="anChkMembership" prefWidth="110" text="Membership" />
                                <TableColumn fx:id="anChkType"       prefWidth="110" text="Type" />
                                <TableColumn fx:id="anChkTime"       prefWidth="160" text="Check-in Time" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-text-fill: #555;" text="No check-ins today." />
                            </placeholder>
                        </TableView>
                    </VBox>

                    <HBox spacing="8">
                        <Label style="-fx-text-fill: #444; -fx-font-size: 11;" text="Data refreshes every 60 seconds." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="analyticsStatus" style="-fx-text-fill: #555; -fx-font-size: 11;" text="" />
                    </HBox>

                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>
</VBox>
