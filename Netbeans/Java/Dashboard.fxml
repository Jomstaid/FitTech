                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-text-fill: #444; -fx-font-size: 11;"
                           text="Select a row then Approve / Reject / Refund." />
                    <Label fx:id="renewalStatus" style="-fx-text-fill: #555; -fx-font-size: 12;" />
                </HBox>

            </VBox>
        </Tab>

