                        <Button onAction="#handleCancelEdit" prefHeight="30" style="-fx-background-color: #222; -fx-text-fill: #aaa; -fx-font-size: 11; -fx-background-radius: 4; -fx-cursor: hand;" text="✕ Cancel" />
