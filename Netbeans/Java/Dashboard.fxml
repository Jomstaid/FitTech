<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-background-color: #0f0f0f;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fittechfrontdesk.controller.DashboardController">

    <!-- ── TOP BAR ── -->
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #00e5ff; -fx-padding: 10 20 10 20;">
        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #0f0f0f;" text="FITTECH FRONT DESK" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="clockLabel" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0f0f0f;                       -fx-background-color: rgba(0,0,0,0.12); -fx-padding: 4 10; -fx-background-radius: 4;" />
        <Label fx:id="welcomeLabel" style="-fx-font-size: 12; -fx-text-fill: #0f0f0f;" />
        <Button onAction="#handleLogout" style="-fx-background-color: rgba(0,0,0,0.2); -fx-text-fill: #0f0f0f; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 4 12;" text="Logout" />
    </HBox>

    <!-- ── STATS BAR ── -->
    <HBox spacing="0" style="-fx-background-color: #111111; -fx-border-color: #222; -fx-border-width: 0 0 1 0;">
        <VBox alignment="CENTER" prefWidth="180" style="-fx-padding: 10; -fx-border-color: #222; -fx-border-width: 0 1 0 0;">
            <Label fx:id="statCheckinsToday" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="—" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #666;" text="Check-ins Today" />
        </VBox>
        <VBox alignment="CENTER" prefWidth="180" style="-fx-padding: 10; -fx-border-color: #222; -fx-border-width: 0 1 0 0;">
            <Label fx:id="statActiveNow" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #7cff6b;" text="—" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #666;" text="Active Sessions" />
        </VBox>
        <VBox alignment="CENTER" prefWidth="180" style="-fx-padding: 10; -fx-border-color: #222; -fx-border-width: 0 1 0 0;">
            <Label fx:id="statWalkinsToday" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #ff8c00;" text="—" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #666;" text="Walk-ins Today" />
        </VBox>
        <VBox alignment="CENTER" prefWidth="180" style="-fx-padding: 10;">
            <Label fx:id="statTotalMembers" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #b57bff;" text="—" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #666;" text="Total Members" />
        </VBox>
    </HBox>

    <!-- ── TAB PANE ── -->
    <TabPane style="-fx-background-color: #0f0f0f; -fx-tab-min-width: 120; -fx-tab-header-area-background: #0f0f0f;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 1 — CHECK IN                        -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="✓  Check In for Members/Visitors">
            <VBox spacing="10" style="-fx-padding: 16; -fx-background-color: #0f0f0f;">

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="searchField" onKeyReleased="#handleSearchLive" prefHeight="36" prefWidth="380" promptText="Search by name, username, status, membership, phone, age..." style="-fx-background-color: #1a1a1a; -fx-text-fill: white;                                       -fx-prompt-text-fill: #555; -fx-border-color: #333;                                       -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 13;" />
                    <Button onAction="#handleSearch" prefHeight="36" style="-fx-background-color: #00e5ff; -fx-text-fill: #0f0f0f;                                    -fx-font-weight: bold; -fx-font-size: 12;                                    -fx-background-radius: 4; -fx-cursor: hand;" text="🔍 Search" />
                    <Button onAction="#handleShowAll" prefHeight="36" style="-fx-background-color: #222; -fx-text-fill: #aaa;                                    -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;" text="Show All" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleRefreshMembers" prefHeight="36" style="-fx-background-color: #1a1a1a; -fx-text-fill: #aaa;                                    -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;" text="⟳ Refresh" />
                </HBox>

                <TableView fx:id="memberTable" style="-fx-background-color: #1a1a1a; -fx-border-color: #333;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="64" minWidth="48" prefWidth="48" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="220" text="Full Name" />
                        <TableColumn fx:id="colUsername" prefWidth="130" text="Username" />
                        <TableColumn fx:id="colMembership" prefWidth="110" text="Membership" />
                        <TableColumn fx:id="colStatus" prefWidth="90" text="Status" />
                        <TableColumn fx:id="colExpiry" prefWidth="110" text="Expiry" />
                        <TableColumn fx:id="colDaysLeft" prefWidth="90" text="Days Left" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555; -fx-font-size: 13;" text="No members loaded. Click Refresh." />
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button onAction="#handleCheckIn" prefHeight="42" prefWidth="240" style="-fx-background-color: #00e5ff; -fx-text-fill: #0f0f0f;                                    -fx-font-weight: bold; -fx-font-size: 13;                                    -fx-background-radius: 4; -fx-cursor: hand;" text="✓  CHECK IN SELECTED" />
                    <Button onAction="#handleWalkin" prefHeight="42" prefWidth="180" style="-fx-background-color: #ff8c00; -fx-text-fill: white;                                    -fx-font-weight: bold; -fx-font-size: 13;                                    -fx-background-radius: 4; -fx-cursor: hand;" text="🚶 LOG WALK-IN" />
                    <Label fx:id="checkInStatus" style="-fx-text-fill: #aaaaaa; -fx-font-size: 13;" wrapText="true" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label style="-fx-text-fill: #555; -fx-font-size: 11;" text="Recently Checked In:" />
                    <Label fx:id="recentCheckins" style="-fx-text-fill: #7cff6b; -fx-font-size: 11;" text="—" wrapText="true" />
                </HBox>

            </VBox>
        </Tab>

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 2 — REGISTER                        -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="＋  Register/Pay Realtime">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #0f0f0f; -fx-background: #0f0f0f;">
                <VBox spacing="14" style="-fx-padding: 24 40 24 40; -fx-background-color: #0f0f0f;">

                    <Label style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="New Member Registration" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #555;" text="All fields marked * are required. Validation matches the FitTech website." />

                    <HBox spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Full Name *" />
                            <TextField fx:id="regFullName" promptText="e.g. Juan Dela Cruz" style="-fx-background-color: #1a1a1a; -fx-text-fill: white;                                               -fx-prompt-text-fill: #555; -fx-border-color: #333;                                               -fx-border-radius: 4; -fx-background-radius: 4;                                               -fx-padding: 9; -fx-font-size: 13;" />
                            <Label fx:id="errFullName" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Username * (3–20 chars, letters/numbers/_)" />
                            <TextField fx:id="regUsername" promptText="e.g. juan_dela_cruz" style="-fx-background-color: #1a1a1a; -fx-text-fill: white;                                               -fx-prompt-text-fill: #555; -fx-border-color: #333;                                               -fx-border-radius: 4; -fx-background-radius: 4;                                               -fx-padding: 9; -fx-font-size: 13;" />
                            <Label fx:id="errUsername" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Email * (Gmail only)" />
                            <TextField fx:id="regEmail" promptText="yourname@gmail.com" style="-fx-background-color: #1a1a1a; -fx-text-fill: white;                                               -fx-prompt-text-fill: #555; -fx-border-color: #333;                                               -fx-border-radius: 4; -fx-background-radius: 4;                                               -fx-padding: 9; -fx-font-size: 13;" />
                            <Label fx:id="errEmail" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Phone * (09XXXXXXXXX or +639XXXXXXXXX)" />
                            <TextField fx:id="regPhone" promptText="09XXXXXXXXX" style="-fx-background-color: #1a1a1a; -fx-text-fill: white;                                               -fx-prompt-text-fill: #555; -fx-border-color: #333;                                               -fx-border-radius: 4; -fx-background-radius: 4;                                               -fx-padding: 9; -fx-font-size: 13;" />
                            <Label fx:id="errPhone" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Birthdate * mm/dd/yyyy (Age must be 15–80)" />
                            <DatePicker fx:id="regBirthdate" maxWidth="Infinity" promptText="Select date" style="-fx-background-color: #1a1a1a; -fx-border-color: #333;                                                -fx-border-radius: 4; -fx-background-radius: 4;" />
                            <Label fx:id="errBirthdate" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Age (auto-calculated)" />
                            <TextField fx:id="regAge" editable="false" promptText="Auto-filled from birthdate" style="-fx-background-color: #111; -fx-text-fill: #00e5ff;                                               -fx-border-color: #222; -fx-border-radius: 4;                                               -fx-background-radius: 4; -fx-padding: 9; -fx-font-size: 13;" />
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Password * (min 8 chars, letter + number/special)" />
                            <PasswordField fx:id="regPassword" promptText="Min 8 characters" style="-fx-background-color: #1a1a1a; -fx-text-fill: white;                                                   -fx-prompt-text-fill: #555; -fx-border-color: #333;                                                   -fx-border-radius: 4; -fx-background-radius: 4;                                                   -fx-padding: 9; -fx-font-size: 13;" />
                            <Label fx:id="errPassword" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Sex *" />
                            <ComboBox fx:id="regGender" maxWidth="Infinity" promptText="Select sex" style="-fx-background-color: #1a1a1a;" />
                            <Label fx:id="errGender" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox prefWidth="280" spacing="4">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Membership Type" />
                            <ComboBox fx:id="regMembership" maxWidth="Infinity" style="-fx-background-color: #1a1a1a;" />
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #aaa; -fx-font-size: 11;" text="Plan Details" />
                            <Label fx:id="membershipPreview" style="-fx-text-fill: #7cff6b; -fx-font-size: 13; -fx-font-weight: bold;" text="Basic — ₱2,500 / 1 month" />
                        </VBox>
                    </HBox>

                    <VBox spacing="4">
                        <Label style="-fx-text-fill: #555; -fx-font-size: 10;" text="Password Strength" />
                        <HBox spacing="4">
                            <Label fx:id="pwStrength1" prefHeight="6" prefWidth="60" style="-fx-background-color: #222; -fx-background-radius: 3;" text="  " />
                            <Label fx:id="pwStrength2" prefHeight="6" prefWidth="60" style="-fx-background-color: #222; -fx-background-radius: 3;" text="  " />
                            <Label fx:id="pwStrength3" prefHeight="6" prefWidth="60" style="-fx-background-color: #222; -fx-background-radius: 3;" text="  " />
                            <Label fx:id="pwStrengthLabel" style="-fx-text-fill: #555; -fx-font-size: 10; -fx-padding: 0 0 0 8;" text="" />
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 6 0 0 0;">
                        <Button fx:id="regButton" onAction="#handleRegister" prefHeight="44" prefWidth="220" style="-fx-background-color: #00e5ff; -fx-text-fill: #0f0f0f;                                        -fx-font-weight: bold; -fx-font-size: 13;                                        -fx-background-radius: 4; -fx-cursor: hand;" text="REGISTER MEMBER" />
                        <Button onAction="#handleClearForm" prefHeight="44" style="-fx-background-color: #222; -fx-text-fill: #aaa;                                        -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;" text="Clear Form" />
                        <Label fx:id="regStatus" maxWidth="380" style="-fx-text-fill: #aaaaaa; -fx-font-size: 12;" wrapText="true" />
                    </HBox>

                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 3 — TODAY'S SCHEDULE                -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="📅  Live Schedule of Trainers">
            <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #0f0f0f;">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="Today's Trainer Bookings" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="liveSessionCount" style="-fx-text-fill: #7cff6b; -fx-font-size: 12; -fx-font-weight: bold;                                   -fx-background-color: rgba(124,255,107,0.1); -fx-padding: 4 10;                                   -fx-background-radius: 12;" text="0 active" />
                    <Button onAction="#handleRefreshSchedule" prefHeight="34" style="-fx-background-color: #333; -fx-text-fill: white;                                    -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 12;" text="⟳ Refresh" />
                </HBox>

                <TableView fx:id="scheduleTable" style="-fx-background-color: #1a1a1a; -fx-border-color: #333;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="schMember" prefWidth="160" text="Member" />
                        <TableColumn fx:id="schTrainer" prefWidth="150" text="Trainer" />
                        <TableColumn fx:id="schDate" prefWidth="100" text="Date" />
                        <TableColumn fx:id="schTime" prefWidth="80" text="Start" />
                        <TableColumn fx:id="schEndTime" prefWidth="80" text="End" />
                        <TableColumn fx:id="schType" prefWidth="140" text="Type" />
                        <TableColumn fx:id="schStatus" prefWidth="90" text="Status" />
                        <TableColumn fx:id="schCountdown" prefWidth="110" text="⏱ Time Left" />
                        <TableColumn fx:id="schAmount" prefWidth="85" text="Amount" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555; -fx-font-size: 13;" text="No bookings for today." />
                    </placeholder>
                </TableView>

                <HBox spacing="20" style="-fx-padding: 4 0 0 0;">
                    <Label style="-fx-text-fill: #7cff6b; -fx-font-size: 11;" text="● Active (in progress)" />
                    <Label style="-fx-text-fill: #00e5ff; -fx-font-size: 11;" text="● Upcoming" />
                    <Label style="-fx-text-fill: #555; -fx-font-size: 11;" text="● Completed" />
                    <Label style="-fx-text-fill: #ff5555; -fx-font-size: 11;" text="● Cancelled" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="scheduleStatus" style="-fx-text-fill: #555; -fx-font-size: 11;" />
                </HBox>

            </VBox>
        </Tab>

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 4 — PENDING ORDERS                  -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="🛒  Pending Approval Orders">
            <VBox spacing="10" style="-fx-padding: 16; -fx-background-color: #0f0f0f;">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="Pending Orders" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #555;" text="(One row per order — select to approve or reject)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="cartSummaryLabel" style="-fx-text-fill: #ffd700; -fx-font-size: 12; -fx-font-weight: bold;                                   -fx-background-color: rgba(255,215,0,0.08); -fx-padding: 4 10;                                   -fx-background-radius: 12;" text="" />
                    <Button onAction="#handleRefreshCart" prefHeight="34" style="-fx-background-color: #333; -fx-text-fill: white;                                    -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 12;" text="⟳ Refresh" />
                </HBox>

                <TableView fx:id="cartTable" style="-fx-background-color: #1a1a1a; -fx-border-color: #333;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="cartColOrderId" prefWidth="70" text="Order #" />
                        <TableColumn fx:id="cartColName" prefWidth="180" text="Member" />
                        <TableColumn fx:id="cartColUsername" prefWidth="120" text="Username" />
                        <TableColumn fx:id="cartColMembership" prefWidth="100" text="Membership" />
                        <TableColumn fx:id="cartColItems" prefWidth="80" text="Items" />
                        <TableColumn fx:id="cartColValue" prefWidth="110" text="Amount" />
                        <TableColumn fx:id="cartColDetail" prefWidth="300" text="Products" />
                        <TableColumn fx:id="cartColDate" prefWidth="140" text="Placed On" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555; -fx-font-size: 13;" text="No pending orders right now." />
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 0 0 0;">
                    <Button fx:id="cartApproveBtn" onAction="#handleApproveOrder" prefHeight="38" prefWidth="160" style="-fx-background-color: #1a3a1a; -fx-text-fill: #7cff6b; -fx-font-weight: bold;                                    -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;                                    -fx-border-color: #2a5a2a; -fx-border-radius: 4;" text="✓  Approve Order" />
                    <Button fx:id="cartRejectBtn" onAction="#handleRejectOrder" prefHeight="38" prefWidth="160" style="-fx-background-color: #3a1a1a; -fx-text-fill: #ff5555; -fx-font-weight: bold;                                    -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;                                    -fx-border-color: #5a2a2a; -fx-border-radius: 4;" text="✗  Reject Order" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-text-fill: #444; -fx-font-size: 11;" text="Select a row then click Approve or Reject." />
                    <Label fx:id="cartStatus" style="-fx-text-fill: #555; -fx-font-size: 11;" />
                </HBox>

            </VBox>
        </Tab>

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 5 — PURCHASE ANALYTICS              -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="💰  Approved Purchases ">
            <VBox spacing="10" style="-fx-padding: 16; -fx-background-color: #0f0f0f;">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="Products Purchased Per Member" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #555;" text="(Approved Orders Only)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="purchaseSummaryLabel" style="-fx-text-fill: #7cff6b; -fx-font-size: 12; -fx-font-weight: bold;                                   -fx-background-color: rgba(124,255,107,0.08); -fx-padding: 4 10;                                   -fx-background-radius: 12;" text="" />
                    <Button onAction="#handleRefreshPurchases" prefHeight="34" style="-fx-background-color: #333; -fx-text-fill: white;                                    -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 12;" text="⟳ Refresh" />
                </HBox>

                <TableView fx:id="purchaseTable" style="-fx-background-color: #1a1a1a; -fx-border-color: #333;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="purColName" prefWidth="180" text="Member" />
                        <TableColumn fx:id="purColUsername" prefWidth="110" text="Username" />
                        <TableColumn fx:id="purColMembership" prefWidth="100" text="Membership" />
                        <TableColumn fx:id="purColOrders" prefWidth="70" text="Orders" />
                        <TableColumn fx:id="purColItems" prefWidth="100" text="Items Bought" />
                        <TableColumn fx:id="purColSpent" prefWidth="110" text="Total Spent" />
                        <TableColumn fx:id="purColFirst" prefWidth="130" text="First Purchase" />
                        <TableColumn fx:id="purColLast" prefWidth="130" text="Last Purchase" />
                        <TableColumn fx:id="purColDetail" prefWidth="380" text="Purchase History" />
                    </columns>
                    <placeholder>
                        <Label style="-fx-text-fill: #555; -fx-font-size: 13;" text="No approved purchases found." />
                    </placeholder>
                </TableView>

                <HBox spacing="8" style="-fx-padding: 4 0 0 0;">
                    <Label style="-fx-text-fill: #444; -fx-font-size: 11;" text="Sorted by total spent (highest first). Only confirmed/approved orders are counted." />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="purchaseStatus" style="-fx-text-fill: #555; -fx-font-size: 11;" />
                </HBox>

            </VBox>
        </Tab>

        <!-- ════════════════════════════════════════ -->
        <!--  TAB 6 — MEMBERS (EDITABLE)              -->
        <!-- ════════════════════════════════════════ -->
        <Tab text="👥  Listed Members">
