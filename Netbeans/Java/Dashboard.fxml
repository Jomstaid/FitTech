                            <Label fx:id="editErrFullName" style="-fx-text-fill: #ff5555; -fx-font-size: 9;" text="" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Username * (3–20 chars)" />
                            <TextField fx:id="editUsername" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-border-color: #333;                                               -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 7; -fx-font-size: 12;" />
                            <Label fx:id="editErrUsername" style="-fx-text-fill: #ff5555; -fx-font-size: 9;" text="" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Email * (Gmail)" />
                            <TextField fx:id="editEmail" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-border-color: #333;                                               -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 7; -fx-font-size: 12;" />
                            <Label fx:id="editErrEmail" style="-fx-text-fill: #ff5555; -fx-font-size: 9;" text="" />
                        </VBox>
                    </HBox>

                    <!-- Row 2: Phone / Gender / Birthdate / Membership / Status / Expiry -->
                    <HBox spacing="14">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Phone *" />
                            <TextField fx:id="editPhone" style="-fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-border-color: #333;                                               -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 7; -fx-font-size: 12;" />
                            <Label fx:id="editErrPhone" style="-fx-text-fill: #ff5555; -fx-font-size: 9;" text="" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Sex *" />
                            <ComboBox fx:id="editGender" maxWidth="Infinity" style="-fx-background-color: #1a1a1a;" />
                            <Label fx:id="editErrGender" style="-fx-text-fill: #ff5555; -fx-font-size: 9;" text="" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Birthdate *" />
                            <DatePicker fx:id="editBirthdate" maxWidth="Infinity" style="-fx-background-color: #1a1a1a; -fx-border-color: #333; -fx-border-radius: 4;" />
                            <Label fx:id="editErrBirthdate" style="-fx-text-fill: #ff5555; -fx-font-size: 9;" text="" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Membership" />
                            <ComboBox fx:id="editMembership" maxWidth="Infinity" style="-fx-background-color: #1a1a1a;" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Status" />
                            <ComboBox fx:id="editStatus" maxWidth="Infinity" style="-fx-background-color: #1a1a1a;" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Expiry Date (leave blank = auto)" />
                            <DatePicker fx:id="editExpiry" maxWidth="Infinity" style="-fx-background-color: #1a1a1a; -fx-border-color: #333; -fx-border-radius: 4;" />
