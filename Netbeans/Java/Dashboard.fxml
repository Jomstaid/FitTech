                    </HBox>

                    <!-- Save row -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button fx:id="editSaveBtn" onAction="#handleSaveMember" prefHeight="36" prefWidth="160" style="-fx-background-color: #00e5ff; -fx-text-fill: #0f0f0f; -fx-font-weight: bold;                                        -fx-font-size: 12; -fx-background-radius: 4; -fx-cursor: hand;" text="💾 Save Changes" />
