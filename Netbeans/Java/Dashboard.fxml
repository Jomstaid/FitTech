                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Location / Area" />
                            <TextField fx:id="equipLocationField" prefHeight="34" promptText="e.g. Main Floor, Storage…"
                                       style="-fx-background-color: #1a1a1a; -fx-text-fill: white;
                                              -fx-border-color: #333; -fx-border-radius: 4;
                                              -fx-background-radius: 4; -fx-font-size: 12;" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Notes" />
                            <TextField fx:id="equipNotesField" prefHeight="34" promptText="Optional notes…"
