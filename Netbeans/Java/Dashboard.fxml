                                              -fx-background-radius: 4; -fx-font-size: 12;" />
                            <Label fx:id="equipErrName" style="-fx-text-fill: #ff5555; -fx-font-size: 10;" text="" />
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Category *" />
                            <ComboBox fx:id="equipCategoryCombo" maxWidth="Infinity" prefHeight="34"
