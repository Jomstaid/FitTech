                        <VBox spacing="3" prefWidth="140">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Condition *" />
                            <ComboBox fx:id="equipConditionCombo" maxWidth="Infinity" prefHeight="34"
