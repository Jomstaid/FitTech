                    </HBox>

                    <!-- Row 1: name, category, qty, condition -->
                    <HBox spacing="12">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label style="-fx-text-fill: #888; -fx-font-size: 10;" text="Equipment Name *" />
                            <TextField fx:id="equipNameField" prefHeight="34" promptText="e.g. Barbell, Treadmill…"
