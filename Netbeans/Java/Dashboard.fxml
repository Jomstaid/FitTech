                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="equipEditName"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #00e5ff;" text="＋ Add Equipment" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="equipDeleteBtn" onAction="#handleDeleteEquip" prefHeight="30"
